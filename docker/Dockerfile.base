# ---------------------------------------------------------------------------
# Shared base image for every Node service in the monorepo.
#
# Build context is always the repository root, so the whole workspace (shared,
# backend, stream-worker, graphics-worker) is available at build time.
# ---------------------------------------------------------------------------
FROM node:20-bookworm-slim

# FFmpeg (encoding, audio mixing, TTS decoding) + fonts for the Skia renderer.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg \
      ca-certificates \
      fonts-dejavu-core \
      fontconfig \
      procps \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
ENV TZ=UTC
WORKDIR /app

# Workspace manifests first: dependency layers stay cached while code changes.
COPY package.json package-lock.json ./
COPY shared/package.json ./shared/
COPY backend/package.json ./backend/
COPY stream-worker/package.json ./stream-worker/
COPY graphics-worker/package.json ./graphics-worker/
COPY frontend/package.json ./frontend/

# Dev dependencies are installed too: the workspaces are TypeScript, so the
# build step below needs tsc (and the Prisma CLI). They are pruned again once
# everything is compiled, which keeps the shipped image as small as before.
#
# `--include=dev` is required: NODE_ENV=production is set above, and npm skips
# devDependencies by default in that case (which is exactly how the first
# publish run ended up with `tsc: not found`).
RUN npm ci --include=dev --ignore-scripts || npm install --include=dev --ignore-scripts

# Full source (tsconfigs, prisma schema, src).
COPY shared ./shared
COPY backend ./backend
COPY stream-worker ./stream-worker
COPY graphics-worker ./graphics-worker

# The Prisma client has to exist *before* the TypeScript build: the backend
# imports its generated types, and without them every Prisma model degrades to
# `any` and `tsc` fails with TS7006 under noImplicitAny.
RUN npx prisma generate --schema=backend/prisma/schema.prisma

# Build the shared types package first, then every service.
RUN npm run build -w @matchcast/shared \
 && npm run build -w @matchcast/backend \
 && npm run build -w @matchcast/stream-worker \
 && npm run build -w @matchcast/graphics-worker

# Drop the build toolchain (tsc, vitest, type packages) from the shipped image.
# `prisma` and `tsx` stay: the backend entrypoint runs `prisma migrate deploy`
# and the seed script on every boot.
RUN npm prune --omit=dev && npm cache clean --force

# Regenerated after the prune as well: the runtime client has to be present in
# the final (production-only) dependency tree.
RUN npx prisma generate --schema=backend/prisma/schema.prisma

RUN mkdir -p /app/.runtime/frames /app/.runtime/preview /app/.runtime/tts /app/.runtime/replay /app/.runtime/logs

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||4000)+'/api/system/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
