# ---------------------------------------------------------------------------
# Frontend: build with Vite, serve the static bundle with nginx.
# nginx proxies /api, /media and /socket.io to the backend service so the
# browser never talks to a second origin.
# ---------------------------------------------------------------------------
FROM node:20-bookworm-slim AS build

WORKDIR /app
COPY package.json package-lock.json ./
COPY shared/package.json ./shared/
COPY frontend/package.json ./frontend/
RUN npm install --ignore-scripts

COPY shared ./shared
COPY frontend ./frontend
RUN npm run build -w @matchcast/shared

# Build-time env for the dashboard (public values only - never secrets).
ARG VITE_API_BASE=/api
ARG VITE_SOCKET_URL=
ARG VITE_PREVIEW_TOKEN=preview
ENV VITE_API_BASE=$VITE_API_BASE
ENV VITE_SOCKET_URL=$VITE_SOCKET_URL
ENV VITE_PREVIEW_TOKEN=$VITE_PREVIEW_TOKEN

RUN npm run build -w @matchcast/frontend

FROM nginx:1.27-alpine

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/frontend/dist /usr/share/nginx/html

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
CMD ["nginx", "-g", "daemon off;"]
