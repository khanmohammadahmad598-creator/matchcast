# The base image can be swapped at build time (CI builds it once and publishes
# it to ghcr.io); local builds keep using the locally built
# `docker build -t matchcast/base:latest -f docker/Dockerfile.base .` image.
ARG BASE_IMAGE=matchcast/base:latest
FROM ${BASE_IMAGE}

ENV NODE_ENV=production
ENV PORT=4000
ENV HOST=0.0.0.0

EXPOSE 4000

# Migrations + seed run through the entrypoint so a fresh volume is usable
# immediately (see docker/entrypoint-backend.sh).
COPY docker/entrypoint-backend.sh /usr/local/bin/entrypoint-backend.sh
RUN chmod +x /usr/local/bin/entrypoint-backend.sh

CMD ["entrypoint-backend.sh"]
