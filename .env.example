# ---------------------------------------------------------------------------
# MatchCast - environment configuration
# Copy to .env in the repository root (and/or in each service folder) and fill in.
# NEVER commit real secrets. The stream key is only ever read by the stream-worker.
# ---------------------------------------------------------------------------

# ------------------------------- general -----------------------------------
NODE_ENV=development
LOG_LEVEL=INFO

# -------------------------------- backend ----------------------------------
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgresql://matchcast:matchcast@postgres:5432/matchcast?schema=public
REDIS_URL=redis://redis:6379
REDIS_ENABLED=true

# 32+ random characters. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
SESSION_COOKIE_NAME=matchcast_token
COOKIE_SECURE=false

# Shared secret the workers use to authenticate their socket + internal API
WORKER_TOKEN=change-me-worker-token
# API key an authorised live-scoring provider sends as X-Scoring-Api-Key
SCORING_API_KEY=change-me-scoring-key

CORS_ORIGINS=http://localhost:5173,http://localhost:8080
ALLOW_ANY_ORIGIN=false

# Runtime artefact directories (uploads, HLS preview, TTS cache, IPC pipes)
MEDIA_DIR=/data/media
PREVIEW_DIR=/data/preview
TTS_DIR=/data/tts
FRAMES_DIR=/data/frames
PREVIEW_TOKEN=preview

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=10

# ----------------------------- stream-worker -------------------------------
BACKEND_URL=http://backend:4000
YOUTUBE_RTMP_URL=rtmps://a.rtmps.youtube.com/live2
# Your YouTube Live stream key. Never commit it, never log it, never send it to the browser.
YOUTUBE_STREAM_KEY=
# Optional: point at a local RTMP server (nginx-rtmp/SRS) for testing without YouTube
# RTMP_TEST_URL=rtmp://127.0.0.1:1935/live/test

FFMPEG_PATH=ffmpeg
HW_ACCEL=auto                # auto | off | nvidia | vaapi | qsv
DEMO_VIDEO=/app/demo-assets/demo-match.mp4
REPLAY_DIR=/data/replay
GRAPHICS_FIFO_NAME=graphics.rgba
AUDIO_FIFO_NAME=commentary.pcm
PREVIEW_ENABLED=true
PIPELINE_WATCHDOG_SECONDS=20
MAX_RESTART_BACKOFF_SECONDS=30

# ---------------------------- graphics-worker ------------------------------
OVERLAY_WIDTH=1920
OVERLAY_HEIGHT=1080
OVERLAY_FPS=15

# ------------------------------ AI providers -------------------------------
# Any of these may be empty - MatchCast falls back to the offline rule-based engine.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ----------------------------- TTS providers -------------------------------
# Any of these may be empty - MatchCast falls back to an offline tone generator.
ELEVENLABS_API_KEY=
GOOGLE_TTS_API_KEY=

# -------------------------------- frontend ---------------------------------
# Leave empty to use the dev-server proxy / production nginx reverse proxy.
VITE_API_BASE=
VITE_SOCKET_URL=
VITE_PREVIEW_TOKEN=preview

# ------------------------------- postgres ----------------------------------
POSTGRES_USER=matchcast
POSTGRES_PASSWORD=matchcast
POSTGRES_DB=matchcast
POSTGRES_PORT=5432

# -------------------------------- seed -------------------------------------
DEFAULT_ADMIN_EMAIL=admin@matchcast.local
DEFAULT_ADMIN_PASSWORD=ChangeMeNow123!
SEED_ADMIN_ON_BOOT=true
