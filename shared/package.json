{
  "name": "@matchcast/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Shared types, zod schemas, socket contracts and scoring maths for MatchCast",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
